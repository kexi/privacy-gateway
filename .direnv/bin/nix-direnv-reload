#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/kei/ghq/github.com/kexi/all-things-agentic-hackathon" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/kei/ghq/github.com/kexi/all-things-agentic-hackathon")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/kei/ghq/github.com/kexi/all-things-agentic-hackathon" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/Users/kei/ghq/github.com/kexi/all-things-agentic-hackathon/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/Users/kei/ghq/github.com/kexi/all-things-agentic-hackathon/.envrc" "/Users/kei/ghq/github.com/kexi/all-things-agentic-hackathon/.direnv"/*.rc
