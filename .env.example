# ---------------------------------------------------------------------------
# Privacy-Preserving Multi-Agent Gateway — environment variables
# `cp .env.example .env` and fill in. The justfile loads .env automatically.
#
# Every variable here is validated with zod at service startup (packages/common
# `config.ts`). An invalid value stops the process with a `config.invalid` log
# line rather than surfacing mid-request.
# ---------------------------------------------------------------------------

# --- Google Cloud / Vertex AI (Core Agent) ---------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1

# The Gemini model id the Core Agent uses. `gemini-3.5-flash` is verified to
# exist on Vertex AI; `gemini-3.5-pro` does not.
GEMINI_MODEL=gemini-3.5-flash

# --- Gemma (self-hosted, OpenAI-compatible endpoint) -----------------------
# Ollama locally; on Cloud Run GPU with internal-only ingress in production.
# Reached through the OllamaLlm adapter registered for `ollama/*` model names.
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma3:12b
# Only used when GEMMA_AUTH=none. Ollama ignores the value but the OpenAI wire
# format requires the header. This is NOT a credential on Cloud Run.
GEMMA_API_KEY=ollama

# How callers authenticate to Gemma: iam | none.
#   iam  - send a Google-signed ID token whose audience is the Gemma service
#          origin. The only credential Cloud Run's run.invoker check accepts.
#   none - send the static GEMMA_API_KEY bearer (local Ollama).
# Left empty it is derived from GEMMA_BASE_URL's scheme: https => iam, http => none.
GEMMA_AUTH=

# --- Service-to-service URLs (A2A) -----------------------------------------
# Base URLs as seen from the Gateway. Agent Cards are resolved underneath them.
# On Cloud Run these are https run.app URLs and every hop then carries a Google
# ID token minted for the callee's origin (packages/common/src/http_client.ts).
# A http://localhost target skips auth entirely, which is what makes `just dev`
# work without cloud credentials. An https target fails closed: if no token can
# be obtained the request is not sent, and the Gateway answers 502 with the
# `auth.id_token.failed` event rather than an opaque downstream 403.
CORE_BASE_URL=http://localhost:8082
SYNTHESIS_BASE_URL=http://localhost:8083
A2A_TIMEOUT_SECONDS=120

# On Cloud Run the Agent Card's url must carry the public hostname.
A2A_PUBLIC_URL=
A2A_HOST=localhost
A2A_PROTOCOL=http

# --- Token Vault / persistence ---------------------------------------------
# memory: in-process (local and tests) / firestore: production
VAULT_BACKEND=memory
VAULT_COLLECTION=token_vault
ANSWER_COLLECTION=gateway_answers
# Vault lifetime in seconds. Each answer's OKF stale_after equals this expiry.
VAULT_TTL_SECONDS=3600

# --- Web UI / server --------------------------------------------------------
# The Vite build output served by the Gateway
WEB_DIR=./web/dist
# Cloud Run injects $PORT. Locally the justfile passes a port per service.
PORT=8081
LOG_LEVEL=INFO

# --- Request limits ---------------------------------------------------------
# Maximum request body in bytes. A prompt is prose; 64 KB is far past any real
# one, and the public endpoint drives two Gemma calls plus a Gemini call.
MAX_BODY_BYTES=65536
# One deadline for the whole gateway -> core -> synthesis chain, in seconds.
REQUEST_DEADLINE_SECONDS=60
# Demo-grade per-IP quota. 0 disables the limiter. The public gateway
# authenticates nobody, so an unbounded endpoint is a cost incident waiting.
RATE_LIMIT_PER_MINUTE=20

# --- Disclosure policy ------------------------------------------------------
# Categories the rehydrator may restore even though they are withheld by
# default (API_KEY, AWS_KEY, JWT, CREDIT_CARD, MY_NUMBER). Comma separated.
# Empty means withhold all of them: the caller already holds those values, and
# echoing them back through a model round trip only widens where they can leak.
REHYDRATE_ALLOW_CATEGORIES=

# --- Observability ----------------------------------------------------------
# Enables OpenTelemetry tracing. With GOOGLE_CLOUD_PROJECT set, spans go to
# Cloud Trace; without it, to the console. See docs/OBSERVABILITY.md.
OTEL_ENABLED=0
OTEL_SERVICE_NAME=

# --- Web build --------------------------------------------------------------
# Project id baked into the UI's Cloud Trace / Logs Explorer links.
VITE_GCP_PROJECT=
