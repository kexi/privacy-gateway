{
  "name": "@privacy-gateway/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@google/adk": "2.0.0",
    "@privacy-gateway/common": "workspace:*",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@privacy-gateway/synthesis": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.3",
  "exports": {
    "./server": {
      "development": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./pipeline": {
      "development": "./src/pipeline.ts",
      "types": "./dist/pipeline.d.ts",
      "default": "./dist/pipeline.js"
    }
  }
}
