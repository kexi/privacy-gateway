{
  "name": "@privacy-gateway/common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./logging": {
      "development": "./src/logging.ts",
      "types": "./src/logging.ts",
      "default": "./dist/logging.js"
    },
    "./config": {
      "development": "./src/config.ts",
      "types": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./schema": {
      "development": "./src/schema.ts",
      "types": "./src/schema.ts",
      "default": "./dist/schema.js"
    },
    "./telemetry": {
      "development": "./src/telemetry.ts",
      "types": "./src/telemetry.ts",
      "default": "./dist/telemetry.js"
    },
    "./attesters/leak-check": {
      "development": "./src/attesters/leak_check.ts",
      "types": "./src/attesters/leak_check.ts",
      "default": "./dist/attesters/leak_check.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate_attestation_digests.mjs && tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "attestation-digests:check": "node scripts/generate_attestation_digests.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^2.4.1",
    "@google/adk": "2.0.0",
    "@google/genai": "^2.9.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "google-auth-library": "^9.15.0",
    "uuid": "^11.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.3"
}
