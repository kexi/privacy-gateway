# --- Node / pnpm ---
node_modules/
dist/
web/dist/
*.tsbuildinfo

# --- Python (standalone PEP 723 scripts only) ---
__pycache__/
*.py[cod]
.ruff_cache/

# --- test artifacts ---
coverage/
web/test-results/
web/playwright-report/
artifacts/demo/

# --- env / secrets ---
.env
.env.*
!.env.example
*-key.json
service-account*.json

# --- Terraform ---
# .terraform/ holds downloaded providers; state may contain resource metadata
# and must never be committed (the real state lives in GCS).
.terraform/
*.tfstate
*.tfstate.*
crash.log
# Variable files may carry per-environment values; example.tfvars is the
# committed template.
*.tfvars
*.tfvars.json
!example.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- OS / editor ---
.DS_Store
*.swp

# direnv/nix-direnv state (machine-local, regenerated by `direnv allow`)
.direnv/
.claude/worktrees/

# pitty writes a per-scenario terminal transcript next to the scenarios. It is
# an unmasked, verbatim record of a live run (prompt text and the rehydrated
# answer), so it is a local debugging artifact, never a committed one.
tests/codex/logs/
