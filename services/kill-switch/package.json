{
  "name": "@privacy-gateway/kill-switch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@google-cloud/run": "^4.0.0",
    "@privacy-gateway/common": "workspace:*",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.3",
  "exports": {
    "./handler": {
      "development": "./src/handler.ts",
      "types": "./src/handler.ts",
      "default": "./dist/handler.js"
    },
    "./notification": {
      "development": "./src/notification.ts",
      "types": "./src/notification.ts",
      "default": "./dist/notification.js"
    },
    "./actions": {
      "development": "./src/actions.ts",
      "types": "./src/actions.ts",
      "default": "./dist/actions.js"
    },
    "./server": {
      "development": "./src/server.ts",
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    }
  }
}
