# Automatically activate the Nix flake devShell through direnv.
# Requires `direnv allow` once, on first use.
use flake

# Machine-local variables such as GOOGLE_CLOUD_PROJECT. .env is gitignored.
dotenv_if_exists .env

# Pin every gcloud / SDK invocation inside this repo to the hackathon project,
# regardless of the user's global `gcloud config`. CLOUDSDK_CORE_PROJECT wins
# over the config file, so a terminal in another repo stays untouched.
# .env (loaded above) can still override for exceptional cases.
export CLOUDSDK_CORE_PROJECT="${CLOUDSDK_CORE_PROJECT:-all-thinkgs}"
export GOOGLE_CLOUD_PROJECT="${GOOGLE_CLOUD_PROJECT:-all-thinkgs}"
export GOOGLE_CLOUD_LOCATION="${GOOGLE_CLOUD_LOCATION:-us-central1}"
